{
  "name": "knbox",
  "version": "0.1.0",
  "description": "A self-hosted web service for uploading and browsing small static webpages.",
  "keywords": [
    "markdown",
    "files",
    "static-site",
    "web-hosting",
    "upload",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "knbox": "bin/knbox.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/summic/knbox.git"
  },
  "files": [
    "bin",
    "src/cli",
    "src/server",
    "dist/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "KNBOX_DEV=1 node bin/knbox.js serve --port 6789",
    "dev:web": "vite",
    "check": "npm run check:types && npm run check:js",
    "check:types": "tsc --noEmit",
    "check:js": "find src bin scripts test \\( -name '*.js' -o -name '*.mjs' \\) | sort | xargs -n1 node --check",
    "test": "node --test",
    "test:unit": "node --test test/unit.test.js",
    "test:api": "node --test test/server.test.js",
    "build": "vite build",
    "start": "node bin/knbox.js serve",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^4.19.2",
    "jose": "^5.10.0",
    "multer": "^2.1.1",
    "playwright-core": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "lucide-react": "^1.17.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
